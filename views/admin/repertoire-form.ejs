<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Repertoire</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main class="main-container admin-container">
      <%- include("partials/nav.ejs") %>
      <h1>Edit Repertoire</h1>

      <% if (error) { %>
        <p class="error-message"><%= error %></p>
      <% } %>

      <p>Edit each section below. Put one work per line.</p>

      <form action="/admin/repertoire" method="POST">
        <% const safeCategories = Array.isArray(categories) ? categories.filter(Boolean) : categories ? [categories] : []; %>
        <% safeCategories.forEach((category, categoryIndex) => { %>
          <fieldset>
            <legend>Section <%= categoryIndex + 1 %></legend>

            <label for="category-<%= categoryIndex %>-title">Section title</label>
            <input
              type="text"
              id="category-<%= categoryIndex %>-title"
              name="categories[<%= categoryIndex %>][title]"
              value="<%= category.title %>"
              required
            />

            <% const safeItems = Array.isArray(category.items) ? category.items.filter(Boolean) : category.items ? [category.items] : []; %>
            <% safeItems.forEach((item, itemIndex) => { %>
              <div>
                <label for="category-<%= categoryIndex %>-item-<%= itemIndex %>-composer">
                  Composer (leave blank for an ungrouped list)
                </label>
                <input
                  type="text"
                  id="category-<%= categoryIndex %>-item-<%= itemIndex %>-composer"
                  name="categories[<%= categoryIndex %>][items][<%= itemIndex %>][composer]"
                  value="<%= item.composer %>"
                />

                <label for="category-<%= categoryIndex %>-item-<%= itemIndex %>-works">
                  Works
                </label>
                <textarea
                  id="category-<%= categoryIndex %>-item-<%= itemIndex %>-works"
                  name="categories[<%= categoryIndex %>][items][<%= itemIndex %>][works]"
                  rows="8"
                  required
                ><%= Array.isArray(item.works) ? item.works.join("\n") : item.works || "" %></textarea>
              </div>
            <% }) %>

            <button
              type="button"
              class="admin-button add-composer-button"
              data-category-index="<%= categoryIndex %>"
              data-next-item-index="<%= safeItems.length %>"
            >
              Add composer
            </button>
          </fieldset>
        <% }) %>

        <button type="submit" class="admin-button">Save Repertoire</button>
      </form>

      <script>
        document.querySelectorAll(".add-composer-button").forEach((button) => {
          button.addEventListener("click", () => {
            const categoryIndex = button.dataset.categoryIndex;
            const itemIndex = Number(button.dataset.nextItemIndex);
            const itemContainer = document.createElement("div");

            itemContainer.innerHTML =
              '<label for="category-' + categoryIndex + '-item-' + itemIndex + '-composer">' +
              'Composer (leave blank for an ungrouped list)' +
              '</label>' +
              '<input type="text" id="category-' + categoryIndex + '-item-' + itemIndex +
              '-composer" name="categories[' + categoryIndex + '][items][' + itemIndex +
              '][composer]" />' +
              '<label for="category-' + categoryIndex + '-item-' + itemIndex + '-works">' +
              'Works' +
              '</label>' +
              '<textarea id="category-' + categoryIndex + '-item-' + itemIndex +
              '-works" name="categories[' + categoryIndex + '][items][' + itemIndex +
              '][works]" rows="8" required></textarea>';

            button.before(itemContainer);
            button.dataset.nextItemIndex = String(itemIndex + 1);
          });
        });
      </script>
    </main>
  </body>
</html>
