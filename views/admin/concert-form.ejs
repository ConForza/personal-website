<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= formTitle %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main class="main-container admin-container">
      <%- include("partials/nav.ejs") %>
      <h1><%= formTitle %></h1>

      <% if (error) { %>
        <p class="error-message"><%= error %></p>
      <% } %>

      <form action="<%= action %>" method="POST">
        <div>
          <label for="date">Date and time</label>
          <input type="datetime-local" id="date" name="date" value="<%= dateValue %>" required />
        </div>

        <div>
          <label for="venue">Venue</label>
          <input type="text" id="venue" name="venue" value="<%= concert.venue %>" required />
        </div>

        <div>
          <label for="notes">Notes</label>
          <textarea id="notes" name="notes" rows="3"><%= concert.notes || "" %></textarea>
        </div>

        <div>
          <label for="repertoire">Programme</label>
          <p>Put one work per line in the format: Composer | Work</p>
          <textarea id="repertoire" name="repertoire" rows="12"><%= concert.repertoire.map((work) => `${work.composer} | ${work.work}`).join("\n") %></textarea>
        </div>

        <button type="submit" class="admin-button">Save Concert</button>
      </form>
    </main>
  </body>
</html>
