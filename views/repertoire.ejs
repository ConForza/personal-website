<!-- Import header -->
<%- include("partials/header.ejs") %>
  <!-- Repertoire lists -->
  <div class="rep-container">
    <div class="logo-container">
      <div class="rep-logo">
        <i class="fa-solid fa-music"></i>
      </div>
    </div>
    <div class="rep-items-container">
      <% categories.forEach((category) => { %>
        <div class="rep-item">
          <h5 class="rep-head"><%= category.title %></h5>
          <ul class="<%= category.title === "Recital" ? "list-composer" : "" %>">
            <% category.items.forEach((item) => { %>
              <% if (item.composer) { %>
                <li>
                  <h6><%= item.composer %></h6>
                  <ul>
                    <% item.works.forEach((work) => { %>
                      <li><%= work %></li>
                    <% }) %>
                  </ul>
                </li>
              <% } else { %>
                <% item.works.forEach((work) => { %>
                  <li><%= work %></li>
                <% }) %>
              <% } %>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  </div>
<!-- Import footer -->
<%- include("partials/footer.ejs") %>
